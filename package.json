{
  "name": "morning-report-bot",
  "version": "0.1.0",
  "private": true,
  "description": "聚合天气/日历课表/GitHub Release/RSS 的每日早报推送机器人(GitHub Actions 定时触发,零服务器成本)",
  "scripts": {
    "morning": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "node-ical": "^0.18.0",
    "rss-parser": "^3.13.0",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "^1.0.9"
  }
}
