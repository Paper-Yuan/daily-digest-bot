{
  "name": "daily-digest-bot",
  "version": "0.1.0",
  "private": true,
  "description": "聚合天气/日历课表/GitHub Release/RSS 的每日早报推送机器人(GitHub Actions 定时触发,零服务器成本)",
  "scripts": {
    "morning": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "node-ical": "^0.18.0",
    "rss-parser": "^3.13.0",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "tsx": "^4.16.0",
    "typescript": "^5.5.4",
    "vitest": "^5.0.0"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "^1.0.9"
  },
  "overrides": {
    "axios": "^1.20.0",
    "uuid": "^11.1.1"
  }
}
